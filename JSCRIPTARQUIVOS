document.addEventListener('DOMContentLoaded', () => {
    // 1. Aplicação de Máscaras Automáticas via Regex
    const aplicarMascara = (id, funcaoMascara) => {
        const campo = document.getElementById(id);
        if (campo) {
            campo.addEventListener('input', (e) => {
                e.target.value = funcaoMascara(e.target.value);
            });
        }
    };

    // Máscara CPF (000.000.000-00)
    aplicarMascara('cpf', (v) => {
        return v.replace(/\D/g, '')
                .replace(/(\d{3})(\d)/, '$1.$2')
                .replace(/(\d{3})(\d)/, '$1.$2')                 .replace(/(\d{3})(\d{1,2})$/, '$1-$2')
                .substring(0, 14);
    });

    // Máscara Telefone ((00) 00000-0000)
    aplicarMascara('telefone', (v) => {
        return v.replace(/\D/g, '')
                .replace(/^(\d{2})(\d)/g, '($1) $2')
                .replace(/(\d{5})(\d)/, '$1-$2')
                .substring(0, 15);
    });

    // Máscara CEP (00000-000)
    aplicarMascara('cep', (v) => {
        return v.replace(/\D/g, '')
                .replace(/^(\d{5})(\d)/, '$1-$2')
                .substring(0, 9);
    });

    // 2. Consulta Automática de Endereço via API (ViaCEP)
    const campoCEP = document.getElementById('cep');
    if (campoCEP) {
        campoCEP.addEventListener('blur', () => {
            const cepLimpo = campoCEP.value.replace(/\D/g, '');
            if (cepLimpo.length === 8) {
                fetch(`https://viacep.com.br/ws/${cepLimpo}/json/`)
                    .then(response => response.json())
                    .then(dados => {
                        if (!dados.erro) {
                            const logradouro = document.getElementById('logradouro');
                            const estado = document.getElementById('estado');
                            if (logradouro) logradouro.value = dados.logradouro;
                            if (estado) estado.value = dados.uf;
                        }
                    })
                    .catch(error => console.error('Erro ao buscar CEP:', error));
            }
        });
    }

    // 3. Feedback no Envio do Formulário
    const form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            if (form.checkValidity()) {
                alert('Cadastro enviado com sucesso! Agradecemos o interesse em apoiar a ONG Doando Esperança.');
                form.reset();
            } else {
                form.reportValidity();
            }
        });
    }
});
