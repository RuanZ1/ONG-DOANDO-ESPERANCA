<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ONG Doando Esperança - Cadastro de Colaboradores</title>
    <link rel="stylesheet" href="css/styles.css">
</head>
<body>
    <header>
        <div class="brand-container">
            <img src="img/logo.png" alt="Logotipo da ONG Doando Esperança">
            <h1>ONG Doando Esperança</h1>
        </div>
        <nav aria-label="Navegação Principal">
            <ul>
                <li><a href="index.html">Início</a></li>
                <li><a href="projetos.html">Projetos Sociais</a></li>
                <li><a href="cadastro.html">Seja Voluntário</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <section>
            <h2>Cadastro de Voluntários e Doadores</h2>
            <p>Preencha o formulário abaixo para se juntar à nossa causa social.</p>

            <form action="#" method="post">
                <fieldset>
                    <legend>Dados Pessoais</legend>
                    <p>
                        <label for="nome">Nome Completo:</label>
                        <input type="text" id="nome" name="nome" required minlength="3" placeholder="Digite seu nome completo">
                    </p>
                    <p>
                        <label for="email">E-mail:</label>
                        <input type="email" id="email" name="email" required placeholder="seuemail@dominio.com">
                    </p>
                    <p>
                        <label for="cpf">CPF:</label>
                        <input type="text" id="cpf" name="cpf" required pattern="\d{3}\.\d{3}\.\d{3}-\d{2}" placeholder="000.000.000-00" title="Digite um CPF válido no formato 000.000.000-00">
                    </p>
                    <p>
                        <label for="telefone">Telefone / WhatsApp:</label>
                        <input type="tel" id="telefone" name="telefone" required pattern="\(\d{2}\)\s?\d{4,5}-\d{4}" placeholder="(11) 99999-9999" title="Digite um telefone válido no formato (11) 99999-9999">
                    </p>
                    <p>
                        <label for="nascimento">Data de Nascimento:</label>
                        <input type="date" id="nascimento" name="nascimento" required>
                    </p>
                </fieldset>

                <fieldset>
                    <legend>Endereço e Localização</legend>
                    <p>
                        <label for="cep">CEP:</label>
                        <input type="text" id="cep" name="cep" required pattern="\d{5}-\d{3}" placeholder="00000-000" title="Digite um CEP válido no formato 00000-000">
                    </p>
                    <p>
                        <label for="logradouro">Rua / Avenida:</label>
                        <input type="text" id="logradouro" name="logradouro" required placeholder="Nome da rua ou avenida">
                    </p>
                    <p>
                        <label for="numero">Número:</label>
                        <input type="number" id="numero" name="numero" required min="1" placeholder="Nº">
                    </p>
                    <p>
                        <label for="estado">Estado (UF):</label>
                        <select id="estado" name="estado" required>
                            <option value="">Selecione...</option>
                            <option value="SP">São Paulo</option>
                            <option value="RJ">Rio de Janeiro</option>
                            <option value="MG">Minas Gerais</option>
                            <option value="RS">Rio Grande do Sul</option>
                            <option value="BA">Bahia</option>
                        </select>
                    </p>
                </fieldset>

                <fieldset>
                    <legend>Perfil de Contribuição</legend>
                    <p>
                        <label for="tipo_colaboracao">Como deseja contribuir?</label>
                        <select id="tipo_colaboracao" name="tipo_colaboracao" required>
                            <option value="">Selecione uma opção...</option>
                            <option value="voluntario">Trabalho Voluntário</option>
                            <option value="doador_mensal">Doador Mensal</option>
                            <option value="doador_pontual">Doador Pontual</option>
                        </select>
                    </p>
                    <p>
                        <label for="mensagem">Mensagem / Observações:</label>
                        <textarea id="mensagem" name="mensagem" rows="4" placeholder="Fale um pouco sobre suas motivações..."></textarea>
                    </p>
                </fieldset>

                <p>
                    <button type="submit">Enviar Cadastro</button>
                    <button type="reset">Limpar Formulário</button>
                </p>
            </form>
        </section>
    </main>

    <footer>
        <p>&copy; 2026 ONG Doando Esperança. Todos os direitos reservados.</p>
    </footer>

    <script src="js/script.js"></script>
</body>
</html>
